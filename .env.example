# Copy to .env.local for local development. On Vercel, add these in Project Settings > Environment Variables.
# Never commit real keys.

PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# Delivery is free. Leave at 0.
DELIVERY_FEE=0

# Minutes a customer's items are held while they pay
RESERVATION_MINUTES=15

# Production storage (Upstash Redis from the Vercel Marketplace sets these for you).
# Leave empty locally: orders and stock are then kept in data/store.json.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
